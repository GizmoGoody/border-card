{
  "name": "border-card",
  "version": "1.0.0",
  "description": "Home Assistant card that wraps any card in a configurable border with an optional progress ring.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": "github:GizmoGoody/border-card",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.1",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "rollup": "^4.24.0",
    "tslib": "^2.8.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0"
  }
}
